{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/kardswalker/kmod-art-mod/art-index.schema.json",
  "title": "kmod art pack index.json (format 1)",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["Asset", "File"],
    "properties": {
      "Asset": {
        "type": "string",
        "description": "Unreal asset path of the replaced texture, no extension, no .ObjectName suffix.",
        "pattern": "^/Game/"
      },
      "File": {
        "type": "string",
        "description": "PNG file relative to the pack folder: '/' separators, no '..', not absolute.",
        "pattern": "^(?!/)(?!.*\\\\)(?!(.*/)?\\.\\.(/|$)).+$"
      },
      "Width": { "type": "integer", "minimum": 1 },
      "Height": { "type": "integer", "minimum": 1 },
      "Format": { "type": "string" }
    },
    "additionalProperties": true
  }
}
